<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
    <PackageVersion Include="AngleSharp" Version="1.4.0" />
    <PackageVersion Include="AngleSharp.Diffing" Version="1.1.1" />
    <PackageVersion Include="Confluent.Kafka" Version="2.14.0" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <PackageVersion Include="Humanizer.Core" Version="2.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.26" />
    <!-- The minor version of Microsoft.Build can't be updated at 17.12.x doesn't support .net8.0, so we must stay on 17.11.x -->
    <PackageVersion Include="Microsoft.Build" Version="17.11.48" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <!--<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="3.11.0"/>-->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.WsFederation" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens.Saml" Version="8.17.0" />
    <PackageVersion Include="MSMQ.Messaging" Version="1.0.4" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Swagger" Version="8.1.4" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageVersion Include="System.DirectoryServices" Version="8.0.0" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="8.0.2" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.3" />
    <PackageVersion Include="System.Web.Services.Description" Version="8.1.2" />
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.StaFact" Version="3.0.13" />
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.11.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="8.0.1" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.NetNamedPipe" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.UnixDomainSocket" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.Federation" Version="8.1.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.26" />
  </ItemGroup>
  <!-- For test projects, override Microsoft.Extensions.* package versions to match the target framework.
       Library projects (targeting net8.0) use versions from the main ItemGroup above.
       Some dependencies have per-TFM transitive requirements that demand TFM-matching versions
       (e.g., Microsoft.IdentityModel.Tokens 8.16.0 on net10.0 requires
       Microsoft.Extensions.Logging.Abstractions >= 10.0.0). -->
  <ItemGroup Condition="('$(IsTestProject)' == 'true') AND ('$(TargetFramework)' == 'net9.0')">
    <PackageVersion Update="Microsoft.Extensions.Caching.Memory" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Logging" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Configuration" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Console" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Debug" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.ObjectPool" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Options" Version="9.0.14" />
    <PackageVersion Update="Microsoft.Extensions.Primitives" Version="9.0.14" />
  </ItemGroup>
  <ItemGroup Condition="('$(IsTestProject)' == 'true') AND ('$(TargetFramework)' == 'net10.0')">
    <PackageVersion Update="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Configuration" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.ObjectPool" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageVersion Update="Microsoft.Extensions.Primitives" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup Condition="('$(IsTestProject)' == 'true') AND ('$(TargetFramework)' == 'net11.0')">
    <PackageVersion Update="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Logging" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Console" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.ObjectPool" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Options" Version="11.0.0-preview.3.26207.106" />
    <PackageVersion Update="Microsoft.Extensions.Primitives" Version="11.0.0-preview.3.26207.106" />
  </ItemGroup>
</Project>