<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- The OperationInvokerGenerator emits 'file' types and '[ModuleInitializer]', which require
         C# 11. Every target framework able to consume CoreWCF (.NET 8 and later) defaults to a
         higher language version than that, so the generator is on by default. Consumers who pin
         LangVersion below 11 can opt out by setting EnableCoreWCFOperationInvokerGenerator=false,
         which falls back to the reflection-based invoker at runtime. -->
    <EnableCoreWCFOperationInvokerGenerator Condition="'$(EnableCoreWCFOperationInvokerGenerator)'==''">true</EnableCoreWCFOperationInvokerGenerator>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exposes EnableCoreWCFOperationInvokerGenerator to the source generator at build time -->
    <CompilerVisibleProperty Include="EnableCoreWCFOperationInvokerGenerator" />
  </ItemGroup>
  <ItemGroup Condition="'$(_CoreWCFSuppressOperationInvokerGeneratorAttribute)'!='true'">
      <!-- Exposes EnableCoreWCFOperationInvokerGenerator at runtime -->
    	<AssemblyAttribute Include="CoreWCF.EnableCoreWCFOperationInvokerGenerator">
	      <_Parameter1>$(EnableCoreWCFOperationInvokerGenerator)</_Parameter1>
        <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
	    </AssemblyAttribute>
  </ItemGroup>
</Project>
